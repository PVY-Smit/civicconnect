# Template only. Real values are shared outside this repository.
# Copy to .env locally. .env is git-ignored and must never be committed.
# See CONTRIBUTING.md, Secrets.

DATABASE_URL="postgresql://user:password@localhost:5432/civicconnect"
PORT=3000

# Must be at least 32 characters. Keep the real value secret and stable.
REFERENCE_KEY=

# Signs the session cookie (FR-001). At least 32 characters; changing it signs everyone out.
SESSION_SECRET=

# true wherever the service runs over HTTPS, so the session cookie is sent only over HTTPS (NFR-006).
COOKIE_SECURE=false

# FR-022, FEC-02: the organisation-wide response target in whole days. An open request older than this
# is overdue. The organisation sets the real value.
OVERDUE_TARGET_DAYS=

# The release this server runs, shown by /health so a measurement can name it. Set by the deployment.
RELEASE=

SEED_REQUESTER_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_COORDINATOR_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_VOLUME=
ALLOW_DESTRUCTIVE_SEED=false
